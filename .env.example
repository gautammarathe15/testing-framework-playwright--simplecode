# Environment Configuration Template
# Copy this file to .env and fill in with your actual values

# ===== APPLICATION SETTINGS =====
BASE_URL=http://localhost:3000
ENV=staging

# ===== BROWSER SETTINGS =====
BROWSER=chromium
# Options: chromium, firefox, webkit
HEADLESS=true
# Set to 'false' to run browser in headed mode

# ===== TEST EXECUTION =====
PARALLEL=2
RETRY=0
TIMEOUT=30000
# TIMEOUT in milliseconds
SLOW_MO=0
# SLOW_MO in milliseconds (adds delay to each action)

# ===== REPORTING & RECORDING =====
RECORD_VIDEO=false
RECORD_HAR=true

# ===== CREDENTIALS =====
TEST_USER=testuser@example.com
TEST_PASSWORD=password123

# ===== CUCUMBER TAGS =====
# TAGS=@SMOKE or @REGRESSION
# TAGS=@SHIFT
# TAGS=@LEAVE
# TAGS=@ATTENDANCE
TAGS=@SMOKE or @REGRESSION

# ===== ALLURE SETTINGS =====
ALLURE_RESULTS_DIR=./allure-results
ALLURE_REPORT_DIR=./allure-report

# ===== DEBUG =====
DEBUG=false
LOG_LEVEL=info
